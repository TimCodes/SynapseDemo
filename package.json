{
  "name": "demo-app",
  "version": "1.0.0",
  "description": "Comprehensive demo application for distributed systems architecture with Kafka and Azure Service Bus",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "setup": "node scripts/setup.js",
    "docker:start": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:restart": "npm run docker:stop && npm run docker:start",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:producer": "docker-compose logs -f kafka-producer-api",
    "docker:logs:consumer": "docker-compose logs -f kafka-consumer-service",
    "docker:logs:function": "docker-compose logs -f azure-function-app",
    "docker:logs:publisher": "docker-compose logs -f servicebus-publisher",
    "docker:logs:kafka": "docker-compose logs -f kafka",
    "docker:build": "docker-compose build",
    "docker:build:nocache": "docker-compose build --no-cache",
    "docker:clean": "docker-compose down -v",
    "docker:ps": "docker-compose ps",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "start": "npm run docker:start",
    "stop": "npm run docker:stop",
    "restart": "npm run docker:restart",
    "logs": "npm run docker:logs",
    "build": "npm run docker:build",
    "clean": "npm run docker:clean",
    "dev": "npm run docker:dev",
    "test": "npm run test --workspaces --if-present",
    "test:producer": "npm run test --workspace=packages/kafka-producer-api",
    "test:consumer": "npm run test --workspace=packages/kafka-consumer-service",
    "test:function": "npm run test --workspace=packages/azure-function-app",
    "test:publisher": "npm run test --workspace=packages/servicebus-publisher",
    "health": "node scripts/health-check.js",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,md}\""
  },
  "keywords": [
    "kafka",
    "azure-service-bus",
    "microservices",
    "docker",
    "kubernetes",
    "demo"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "prettier": "^3.2.5"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
